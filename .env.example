# ============================================================
#  AIfred — configuration
#  En local : copie ce fichier en ".env" et remplis-le.
#  Sur Bunny Magic Containers : mêmes noms, dans les variables de l'application.
#  Ne commite jamais le fichier .env.
# ============================================================

# --- Requis ---

# LiveKit Cloud (cloud.livekit.io > Settings > API Keys), projet AIfred
LIVEKIT_URL=wss://xxxx.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Claude (le cerveau) et Gradium (les oreilles et la voix), lus par l'agent seulement
ANTHROPIC_API_KEY=
GRADIUM_API_KEY=

# Adresse publique du serveur (liens WhatsApp, photos). En local : http://localhost:8080
AIFRED_PUBLIC_URL=http://localhost:8080

# Code de l'équipe, obligatoire en ligne. Lien à donner à l'équipe : <AIFRED_PUBLIC_URL>/?equipe=<code>
# Générer : openssl rand -hex 8
AIFRED_TEAM_CODE=

# --- WhatsApp par Zernio (sans ces deux lignes : mode essai, le lien s'affiche dans la visio) ---

# Clé API Zernio (zernio.com > Settings > API Keys)
ZERNIO_API_KEY=
# Id Zernio du numéro WhatsApp d'AIfred (jamais celui de Plat du Jour)
ZERNIO_WHATSAPP_ACCOUNT_ID=
# Démo avec le bac à sable Zernio (numéro US gratuit) : 1, et l'id donné par
# « uv run python whatsapp.py sandbox » dans ZERNIO_WHATSAPP_ACCOUNT_ID (voir README)
# ZERNIO_SANDBOX=1
# Modèle WhatsApp approuvé par Meta (voir README) et sa langue
# AIFRED_WHATSAPP_TEMPLATE=aifred_visio
# AIFRED_WHATSAPP_TEMPLATE_LANGUAGE=fr

# --- Optionnel ---

# Modèle Claude (défaut : claude-haiku-5-5, le plus rapide pour la voix)
# AIFRED_LLM_MODEL=claude-haiku-5-5
# Voix Gradium (défaut : Leo, voix masculine française)
# AIFRED_VOICE_ID=axlOaUiFyOZhy4nv
# Dossier de la base SQLite et des photos (défaut : ./data ; sur Bunny : /data)
# AIFRED_DATA_DIR=./data
# Contacts et maisons de démo en JSON, même forme que demo.example.json (vrais numéros des testeurs)
# AIFRED_DEMO_JSON=
# Validité d'un lien d'invitation, en heures
# AIFRED_INVITATION_HOURS=12
